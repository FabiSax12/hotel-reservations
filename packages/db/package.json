{
  "name": "@hotel/db",
  "version": "0.0.0",
  "private": true,
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./client": "./src/client.ts",
    "./types": "./src/types.ts"
  },
  "scripts": {
    "lint": "biome check .",
    "type-check": "tsc --noEmit",
    "generate-types": "supabase gen types typescript --project-id vhnblyovgvpamjsqlzix > src/database.types.ts",
    "clean": "rm -rf dist .turbo node_modules",
    "db:push": "supabase db push",
    "db:types": "supabase gen types typescript --project-id vhnblyovgvpamjsqlzix > src/database.types.ts",
    "db:migration": "supabase migration new",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase reset",
    "db:status": "supabase status",
    "db:logs": "supabase logs",
    "db:dump": "supabase db dump"
  },
  "dependencies": {
    "@supabase/ssr": "^0.10.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "supabase": "^2.84.4",
    "typescript": "^5.8.0"
  }
}
